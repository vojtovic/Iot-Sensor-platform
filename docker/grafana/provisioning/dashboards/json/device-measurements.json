          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(m.time, $__interval),\n  s.channel AS metric,\n  avg(m.value) AS value\nFROM\n  measurements m\n  JOIN sensors s ON s.id = m.sensor_id\nWHERE\n  $__timeFilter(m.time)\n  AND m.quality = 0\n  AND s.device_id = $device\n  AND s.channel IN (${channel:sqlstring})\nGROUP BY\n  1,\n  2\nORDER BY\n  1",
