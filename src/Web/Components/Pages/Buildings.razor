@page "/buildings"
@using Web.Models
@inject IHttpClientFactory HttpFactory
@rendermode InteractiveServer


<PageTitle>Buildings</PageTitle>
<h1>Buildings</h1>
<div class="mb-3">
    <input class="form-control mb-2" placeholder="Name" @bind="newName"/>
    <input class="form-control mb-2" placeholder="Address" @bind="newAddress"/>
    <button class="btn btn-primary" @onclick="AddBuilding">Add building</button>
</div>

<div>
    <input class="form-control mb-2" type="search" placeholder="Search.." @bind="NameFilter" @bind:event="oninput"/>
</div>

@if(message is not null){
<div class="alert alert-info">@message</div>
}

@if (buildings is null)
{
    <p>loading…</p>
}
else if (buildings.Count == 0)
{
    <p>None.</p>
}
else
{
<span class="badge rounded-pill text-bg-secondary">@buildings.Count</span>
    <table class="table">
        <thead>
            <tr><th>Id</th><th>Name</th><th>Address</th><th>Detail</th></tr>
        </thead>
        <tbody>
            @foreach (var b in FilteredBuildings)
            {
                <tr>
                    <td>@b.Id</td>
                    <td>@b.Name</td>
                    <td>@b.Address</td>
                    <td><a href="buildings/@b.Id/rooms">Detail</a></td>
                </tr>
            }
        </tbody>
    </table>
}



@code {
    private string newName = "";
    private string? newAddress;
    private string? message;

    private List<BuildingDto>? buildings;

    protected override async Task OnInitializedAsync()
    {
        var api = HttpFactory.CreateClient("Api");
        buildings = await api.GetFromJsonAsync<List<BuildingDto>>("api/v1/buildings");

    }

    private async Task AddBuilding()
    {
    var api = HttpFactory.CreateClient("Api");
    var request = new CreateBuildingRequest {Name = newName, Address = newAddress};
    var response = await api.PostAsJsonAsync("api/v1/buildings",request);
        if(response.IsSuccessStatusCode){
            message = "Buildig was added";
            newName = "";
            newAddress = null;
            buildings = await api.GetFromJsonAsync<List<BuildingDto>>("api/v1/buildings");

        }else
        {
            var body = await response.Content.ReadAsStringAsync();
            message = $"Error {(int)response.StatusCode}:{body}";

        }
    }


    private string? NameFilter;

    private IEnumerable<BuildingDto> FilteredBuildings =>
        buildings?.Where(m => m.Name.Contains(NameFilter ?? string.Empty,StringComparison.OrdinalIgnoreCase)||(m.Address?.Contains(NameFilter ?? string.Empty,StringComparison.OrdinalIgnoreCase)?? false)) ?? [];
}
