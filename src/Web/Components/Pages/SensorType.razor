@page "/sensor-types"
@using Web.Models
@inject IHttpClientFactory HttpFactory
@rendermode InteractiveServer


<PageTitle>Sensor types</PageTitle>
<h1>Sensor types</h1>
<div class="mb-3">
    <input class="form-control mb-2" placeholder="Code" @bind="newCode"/>
    <input class="form-control mb-2" placeholder="Unit" @bind="newUnit"/>
    <input class="form-control mb-2" type="number" step="any" placeholder="MinValid" @bind="newMinValid"/>
    <input class="form-control mb-2" type="number" step="any" placeholder="MaxValid" @bind="newMaxValid"/>
    <button class="btn btn-primary" @onclick="AddSensorType">Add Sensor Type</button>
</div>

<div>
    <input class="form-control mb-2" type="search" placeholder="Search.." @bind="NameFilter" @bind:event="oninput"/>
</div>

@if(message is not null){
<div class="alert alert-info">@message</div>
}

@if (sensorTypes is null)
{
    <p>loading…</p>
}
else if (sensorTypes.Count == 0)
{
    <p>None.</p>
}
else
{
<span class="badge rounded-pill text-bg-secondary">@sensorTypes.Count</span>
    <table class="table">
        <thead>
            <tr><th>Id</th><th>Code</th><th>Unit</th><th>MaxValid</th><th>MinValid</th></tr>
        </thead>
        <tbody>
            @foreach (var b in FilteredSensorTypes)
            {
                <tr>
                    <td>@b.Id</td>
                    <td>@b.Code</td>
                    <td>@b.Unit</td>
                    <td>@b.MaxValid</td>
                    <td>@b.MinValid</td>
                </tr>
            }
        </tbody>
    </table>
}



@code {
    private string newCode = "";
    private string newUnit = "";
    private double newMaxValid;
    private double newMinValid;
    private string? message;
    private List<SensorTypeDto>? sensorTypes;

    protected override async Task OnInitializedAsync()
    {
        var api = HttpFactory.CreateClient("Api");
        sensorTypes = await api.GetFromJsonAsync<List<SensorTypeDto>>("api/v1/sensor-types");

    }

    private async Task AddSensorType()
    {
    var api = HttpFactory.CreateClient("Api");
    var request = new AddSensorTypeDto {Code = newCode, Unit = newUnit, MaxValid = newMaxValid, MinValid = newMinValid};
    var response = await api.PostAsJsonAsync("api/v1/sensor-types",request);
        if(response.IsSuccessStatusCode){
            message = "SensorType was added";
            newCode = "";
            newUnit = "";
            newMaxValid = 0;
            newMinValid = 0;
            sensorTypes = await api.GetFromJsonAsync<List<SensorTypeDto>>("api/v1/sensor-types");

        }else
        {
            var body = await response.Content.ReadAsStringAsync();
            message = $"Error {(int)response.StatusCode}:{body}";

        }
    }


    private string? NameFilter;

    private IEnumerable<SensorTypeDto> FilteredSensorTypes =>
        sensorTypes?.Where(m => m.Code.Contains(NameFilter ?? string.Empty,StringComparison.OrdinalIgnoreCase)) ?? [];
}
